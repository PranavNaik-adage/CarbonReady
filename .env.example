# CarbonReady sensor API bridge — environment variables
#
# These point at the standalone CarbonReady Supabase project (its own database,
# independent of any other project). Copy this file to .env.local and fill in
# real values. Never commit .env / .env.local.

# CarbonReady Supabase project URL, e.g. https://<project-ref>.supabase.co
# (The project ref is the "ref" claim inside the anon key JWT.)
CARBONREADY_SUPABASE_URL=https://your-project-ref.supabase.co

# CarbonReady Supabase ANON / public key (the eyJ... token with "role":"anon").
# Do NOT use the service-role / secret key here — the anon key plus RLS policies
# is all the bridge needs.
CARBONREADY_SUPABASE_ANON_KEY=eyJ...your-anon-key

# Optional shared token guarding the /api/sensor/* routes.
# If set, callers must send it as `Authorization: Bearer <token>` or `x-api-key`.
# If unset, the routes allow unauthenticated access (dev only).
SENSOR_API_TOKEN=
