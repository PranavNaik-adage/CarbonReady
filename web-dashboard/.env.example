# API Configuration
VITE_API_URL=https://your-api-gateway-url.execute-api.region.amazonaws.com/prod

# Cognito Configuration (for future authentication)
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_REGION=your-region

# CarbonReady Supabase (live sensor data for the Sensor Monitoring page)
# Points at the standalone CarbonReady Supabase project. Use the anon/public key,
# NOT the service-role/secret key. The anon key is safe in the browser because RLS
# only permits read access.
VITE_CARBONREADY_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_CARBONREADY_SUPABASE_ANON_KEY=eyJ...your-anon-key
